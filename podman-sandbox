#!/usr/bin/env bash
# podman-sandbox: run Podman in a restricted sandbox where the defaults fail.
#
# What it fixes, in one place:
#   - overlay / fuse-overlayfs cannot mount (no /dev/fuse)  -> vfs storage
#   - crun fails opening sd-bus                            -> --cgroups=disabled
#   - a separate network namespace is refused              -> default --network=host
#     (--network=none also fails on the VM in place from 2026-11-10:
#     crun ioctl(SIOCSIFFLAGS) is refused, so host is the only working mode)
#   - rootful Podman ignores ~/.config/containers/*.conf   -> this wrapper
#     passes the storage flags explicitly, so it works even when
#     /etc/containers/*.conf has been wiped by a VM replacement.
#
# Usage:
#   podman-sandbox run --rm docker.io/library/hello-world
#   podman-sandbox run --network=host --rm docker.io/library/alpine sh
#   podman-sandbox build --network=host -t myimage .   # build containers
#     also need cgroup handling: the wrapper adds --cgroup-manager=cgroupfs
#     for build, or RUN steps fail with "crun: cannot open sd-bus"
#   podman-sandbox check        # diagnostics, no container run
#   podman-sandbox install      # run install.sh (apt install + /etc config)
#   podman-sandbox <any podman args>   # passed through with storage flags
#
# Data directory: $PODMAN_SANDBOX_DATA if set, else
# $HOME/workspace/podman-data if a workspace exists, else
# $HOME/.local/share/podman-sandbox-data. Images stored there survive
# a VM replacement when the directory is under a persistent home.
set -euo pipefail

if [ "${1:-}" = "check" ]; then
  if [ -x "$(dirname "${BASH_SOURCE[0]}")/check.sh" ]; then
    exec "$(dirname "${BASH_SOURCE[0]}")/check.sh"
  elif command -v podman-sandbox-check >/dev/null 2>&1; then
    exec podman-sandbox-check
  else
    echo "podman-sandbox: check.sh not found; run ./check.sh from the repo" >&2
    exit 1
  fi
fi
if [ "${1:-}" = "install" ]; then
  exec "$(dirname "${BASH_SOURCE[0]}")/install.sh"
fi

if ! command -v podman >/dev/null 2>&1; then
  echo "podman-sandbox: podman is not installed. Run: podman-sandbox install" >&2
  exit 1
fi

if [ -n "${PODMAN_SANDBOX_DATA:-}" ]; then
  DATA_DIR="$PODMAN_SANDBOX_DATA"
elif [ -d "$HOME/workspace" ]; then
  DATA_DIR="$HOME/workspace/podman-data"
else
  DATA_DIR="$HOME/.local/share/podman-sandbox-data"
fi
mkdir -p "$DATA_DIR/graphroot" "$DATA_DIR/runroot"

# Refuse the one mode known to fail here, with a useful message, rather
# than letting netavark fail cryptically. Both spellings are checked:
# `--network=bridge` and `--network bridge` (and the --net alias).
# The space-separated form used to slip through (audit 2026-11-10).
prev=""
for arg in "$@"; do
  case "$arg" in
    --network=bridge|--network=private|--net=bridge|--net=private)
      echo "podman-sandbox: isolated bridge networking is blocked in this sandbox (netavark setns: Operation not permitted)." >&2
      echo "Use --network=host instead (--network=none currently fails on this VM: crun ioctl SIOCSIFFLAGS, see README)." >&2
      exit 2
      ;;
    bridge|private)
      if [ "$prev" = "--network" ] || [ "$prev" = "--net" ]; then
        echo "podman-sandbox: isolated bridge networking is blocked in this sandbox (netavark setns: Operation not permitted)." >&2
        echo "Use --network=host instead (--network=none currently fails on this VM: crun ioctl SIOCSIFFLAGS, see README)." >&2
        exit 2
      fi
      ;;
  esac
  prev="$arg"
done

# For run/create, default to --network=host when the user did not pick a
# network mode, and always disable cgroups (the sd-bus failure otherwise).
# The default used to be --network=none, but on the replacement VM in
# place from 2026-11-10, --network=none fails for every container with
# "crun: ioctl(SIOCSIFFLAGS): Operation not permitted" (bringing up the
# loopback interface is refused), even with --cgroups=disabled and even
# though the caps now include cap_net_admin. --network=host still works,
# so host is the default until a future VM makes none work again; if it
# does, flip this back to --network=none and update check.sh/README.
ARGS=()
HAS_NETWORK=0
IS_RUN=0
for arg in "$@"; do
  case "$arg" in
    --network*|--net*) HAS_NETWORK=1 ;;
    run|create) IS_RUN=1 ;;
  esac
  ARGS+=("$arg")
done

PODMAN_ARGS=(--storage-driver=vfs --root "$DATA_DIR/graphroot" --runroot "$DATA_DIR/runroot")
# Build containers hit the same sd-bus failure as run containers, but
# via the cgroup manager instead of --cgroups=disabled: add
# --cgroup-manager=cgroupfs for build (global flag, before the verb).
if [ "${1:-}" = "build" ]; then
  PODMAN_ARGS+=(--cgroup-manager=cgroupfs)
fi
if [ "$IS_RUN" = "1" ]; then
  # --cgroups and --network are run/create flags, not global podman flags,
  # so they must be inserted right after the run/create verb.
  OUT=()
  INSERTED=0
  for arg in "${ARGS[@]}"; do
    OUT+=("$arg")
    if [ "$INSERTED" = "0" ] && { [ "$arg" = "run" ] || [ "$arg" = "create" ]; }; then
      OUT+=(--cgroups=disabled)
      if [ "$HAS_NETWORK" = "0" ]; then
        OUT+=(--network=host)
      fi
      INSERTED=1
    fi
  done
  ARGS=("${OUT[@]}")
fi

exec podman "${PODMAN_ARGS[@]}" "${ARGS[@]}"
