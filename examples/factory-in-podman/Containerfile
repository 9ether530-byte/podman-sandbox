# Containerfile for the Digital Download Factory.
#
# This replaces the earlier commit-after-demo hack: one reproducible
# build, instead of a container committed after a demo run (each
# commit was a ~276 MB full filesystem copy under vfs).
#
# Build with ./build-image.sh, not by hand: that script copies the
# factory code into an isolated build context, passes the proxy and
# egress CA bundle through as build args / a build volume when they
# exist, and tags the result factory-sandbox:latest.
#
# The factory code itself is not in this repo; build-image.sh copies
# app/, cli.py and requirements.txt from a factory checkout.
FROM docker.io/library/python:3.12-slim
WORKDIR /code

# Build args only: available during RUN, not persisted in the image
# unless an ENV line copies them (none does, on purpose).
ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG PIP_CERT
ARG SSL_CERT_FILE
ARG REQUESTS_CA_BUNDLE

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY cli.py .

EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
